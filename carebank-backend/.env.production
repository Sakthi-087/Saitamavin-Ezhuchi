# Production Environment Configuration
# Copy this file to .env and fill in your production values

APP_ENV=production
REQUIRE_STRICT_SECURITY=true

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Frontend URL (required for CORS)
FRONTEND_URL=https://yourproject.vercel.app

# Production guardrails
INTERNAL_METRICS_TOKEN=your_internal_metrics_token
RATE_LIMIT_ENABLED=true
ENABLE_AUDIT_PERSISTENCE=true
ENABLE_LOCAL_EVENT_FALLBACK=false
ENABLE_SAMPLE_DATA_FALLBACK=false
ENABLE_WEBSOCKET_DEV_FALLBACK=false

# LLM Configuration (required for AI features)
AI_CATEGORIZATION_ENABLED=false
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=your_openrouter_api_key

# Alternative: Use OpenAI directly (uncomment if using OpenAI instead of OpenRouter)
# OPENAI_API_KEY=your_openai_api_key
